# 복사해서 frontend/.env.local 로 사용 (커밋 금지 — .gitignore에 .env*.local 포함).

# 백엔드 API 주소 (로컬 기본값)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Supabase (Auth 전용). https://supabase.com 무료 프로젝트 생성 후 값 입력.
# 미설정이면 개발 스캐폴딩 모드(인증 없이 화면 열람 가능).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 웹푸시 구독용 공개키 (backend/.env 의 VAPID_PUBLIC_KEY 와 반드시 동일한 값)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# 카카오 "나에게 보내기" 알림 연동 (설정 화면에서 사용). 미설정이면 카카오 연동 버튼 비활성화.
NEXT_PUBLIC_KAKAO_CLIENT_ID=
NEXT_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3000/settings
