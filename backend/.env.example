# 복사해서 backend/.env 로 사용 (커밋 금지 — .gitignore에 .env 포함).

# --- 필수 ---
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/reviewdb
SUPABASE_JWT_SECRET=
GEMINI_API_KEY=
INTERNAL_API_KEY=

# --- LLM 모델 (선택, 기본값 있음) ---
# LLM_MODEL_CLASSIFY=gemini-2.0-flash
# LLM_MODEL_GENERATE=gemini-2.5-flash

# --- 네이버 지역 검색(NAVER API HUB, 온보딩 매장 검색 자동완성) ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 웹푸시 VAPID (로컬에서 `vapid --gen` 등으로 즉시 생성 가능) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- 카카오 "나에게 보내기" 알림 ---
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=
KAKAO_CLIENT_SECRET=

# --- 크롤러 스냅샷 (선택, 기본값 있음) ---
# SNAPSHOT_DIR=/data/snapshots
